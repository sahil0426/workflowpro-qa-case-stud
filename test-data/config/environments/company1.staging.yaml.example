# Rename to company1.staging.local.yaml and fill in real values.
# Credentials are referenced by env var name only — never store secrets here.
tenant:
  id: "company1"
  subdomain: "company1.workflowpro.com"
  base_url: "https://company1.workflowpro.com"
api_base_url: "https://api.workflowpro.com"
default_timeout_ms: 15000
browsers: ["chromium", "firefox", "webkit"]
test_users:
  admin:
    email_env: "WFP_COMPANY1_ADMIN_EMAIL"
    password_env: "WFP_COMPANY1_ADMIN_PASSWORD"
  manager:
    email_env: "WFP_COMPANY1_MANAGER_EMAIL"
    password_env: "WFP_COMPANY1_MANAGER_PASSWORD"
  employee:
    email_env: "WFP_COMPANY1_EMPLOYEE_EMAIL"
    password_env: "WFP_COMPANY1_EMPLOYEE_PASSWORD"
